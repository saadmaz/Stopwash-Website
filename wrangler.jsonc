{
  // Cloudflare Workers configuration. `bun run build` merges this into .output/server/wrangler.json.
  // Cloudflare Workers Builds (connected in the dashboard) builds and deploys every push to main.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "stopwash-website",
  // Pinned so Cloudflare runtime behaviour only changes when this date is moved on deliberately.
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],

  // Always reachable at stopwash-website.<account>.workers.dev, with preview URLs for other branches.
  // stopwash.lk and www.stopwash.lk are attached in the dashboard (Worker > Settings > Domains & Routes)
  // once the domain is active in this account; src/server.ts redirects www to stopwash.lk.
  "workers_dev": true,
  "preview_urls": true,

  "observability": { "enabled": true }
}
