{
  // Cloudflare Workers configuration. `bun run build` merges this into .output/server/wrangler.json,
  // Cloudflare Workers Builds (connected in the dashboard) builds and deploys every push to main.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "stopwash-website",
  // Pinned so Cloudflare runtime behaviour only changes when this date is moved on deliberately.
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],

  // stopwash.lk must be an active zone in the same Cloudflare account before the first deploy.
  // www.stopwash.lk is redirected to stopwash.lk by src/server.ts.
  "routes": [
    { "pattern": "stopwash.lk", "custom_domain": true },
    { "pattern": "www.stopwash.lk", "custom_domain": true }
  ],

  "observability": { "enabled": true }
}
